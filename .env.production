# ===================================
# 生产环境配置模板
# 部署时复制为 .env 并填入真实值
# Docker 容器内 localhost/127.0.0.1 指向容器自身，需改为宿主机或服务 IP
# ===================================

# ===================================
# Mysql 配置（leang 模块用）
# !! 不能用 localhost，需填服务器内网 IP
# ===================================
DB_HOST=<服务器内网IP>
DB_PORT=3306
DB_USER=guoqing
DB_PASSWORD=guoqing666
DB_NAME=for_student
DB_CHARSET=utf8mb4

# ===================================
# Email 配置
# ===================================
EMAIL_PASSWORD=xxxx
SENDER_EMAIL=1124317604@qq.com

# ===================================
# LLM Basic 配置
# ===================================
LLM_TIMEOUT=30

# ===================================
# DashScope 配置
# ===================================
DSC_API_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen3-max
DASHSCOPE_API_KEY=<你的DashScope API Key>
QWEN_EMBEDDING_MODEL_NAME=text-embedding-v3
QWEN_ASR_MODEL_NAME=qwen3-asr-flash
QWEN_OCR_MODEL_NAME=qwen-vl-ocr-latest

# ===================================
# DeepSeek
# ===================================
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=<你的DeepSeek API Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===================================
# Redis 配置
# ===================================
REDIS_HOST=47.115.57.130
REDIS_PORT=6379
REDIS_DB=0
#REDIS_PASSWORD=

# ===================================
# ffmpeg 配置（容器内已安装）
# ===================================
FFMPEG_PATH=/usr/bin/ffmpeg

# ===================================
# 日志 配置
# ===================================
LOG_LEVEL=INFO

# ===================================
# MinIO 配置
# !! 不能用 127.0.0.1
# ===================================
MINIO_ACCESS_KEY=xxxx
MINIO_SECRET_KEY=xxxx
MINIO_ENDPOINT=<服务器内网IP>:9000

# ===================================
# Tencent Cloud COS 配置
# ===================================
TC_SECRET_ID=<你的腾讯云SecretId>
TC_SECRET_KEY=<你的腾讯云SecretKey>
TC_REGION=ap-guangzhou
TC_TOKEN=
TC_SCHEME=https
TC_BUCKET_NAME=<你的COS桶名>
TC_PROXY_HTTP_IP=
TC_PROXY_HTTPS_IP=

# ===================================
# Wolin MinIO 配置
# ===================================
MINIO_ASR_TEXT_BUCKET_NAME=audio-text

# ===================================
# Base 模块
# ===================================
BASE_DB_NAME=ric_ai_base

# ===================================
# Milvus 向量数据库连接配置
# ===================================
MILVUS_HOST=10.0.10.106
MILVUS_PORT=19530
MILVUS_URI=http://10.0.10.106:19530
MILVUS_USER=leang
MILVUS_PASSWORD=Abc123123.
MILVUS_DATABASE=default
MILVUS_TIMEOUT=10
MILVUS_COLLECTION_NAME=leang_documents
VECTOR_DIM=768
MILVUS_SECURE=False
MILVUS_ALIAS=default

# ===================================
# 飞书应用配置（leang RAG 机器人）
# ===================================
FEISHU_APP_ID=<你的飞书App ID>
FEISHU_APP_SECRET=<你的飞书App Secret>
FEISHU_COLLECTION_NAME=leang_documents

# ===================================
# sql_to_index 模块 — Apache Doris（MySQL 协议）
# ===================================
STI_DB_HOST=10.0.10.24
STI_DB_PORT=9030
STI_DB_USER=root
STI_DB_PASSWORD=<Doris 密码>
STI_DB_NAME=doris
STI_DB_CHARSET=utf8mb4

# sql_to_index — 主 LLM
STI_LLM_API_KEY=<主LLM API Key>
STI_LLM_BASE_URL=https://www.aitokens.link/v1
STI_LLM_MODEL=gpt-3.5-turbo

# sql_to_index — 备用 LLM（通义千问）
STI_LLM_FALLBACK_API_KEY=<备用LLM API Key，可复用 DASHSCOPE_API_KEY>
STI_LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
STI_LLM_FALLBACK_MODEL=qwen3-max

# sql_to_index — 飞书应用（独立应用）
STI_FEISHU_APP_ID=<STI飞书App ID>
STI_FEISHU_APP_SECRET=<STI飞书App Secret>
